# Holiday River Expeditions — Environment Variables
# Copy to .env.local and fill in values

# Site URL (used for metadata, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=
# Shared secret for the Sanity publish webhook (/api/revalidate).
# Generate any long random string; must match the webhook config in
# sanity.io/manage. See docs/reference/sanity-revalidation-webhook.md
SANITY_REVALIDATE_SECRET=

# Arctic Reservations API — OAuth installation-key credentials, created in
# Arctic admin (Settings > API Access, client "hre-website", User level).
# GOTCHA: Next's env parser treats # as a comment and expands $VAR. If a
# secret contains either, double-quote the value and escape dollars as \$:
#   ARCTIC_CLIENT_SECRET="abc\$def#ghi"
ARCTIC_API_BASE_URL=
ARCTIC_CLIENT_ID=
ARCTIC_CLIENT_SECRET=
ARCTIC_USERNAME=
ARCTIC_PASSWORD=

# Feature flag: native in-row booking via the Arctic Public Cart API.
# Off/unset = departure rows link to Arctic's hosted reserve flow.
BOOKING_NATIVE=
