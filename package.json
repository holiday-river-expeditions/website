{
    "name": "website",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.29.3",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit",
        "typegen": "sanity schema extract && sanity typegen generate",
        "prepare": "husky"
    },
    "dependencies": {
        "@portabletext/react": "^6.2.0",
        "@sanity/client": "^7.26.2",
        "@sanity/image-url": "^2.1.1",
        "@sanity/vision": "^5.31.1",
        "maplibre-gl": "^6.6.0",
        "next": "16.3.0",
        "next-sanity": "^13.3.1",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-map-gl": "^8.1.2",
        "sanity": "^5.31.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.3.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "pnpm": {
        "overrides": {
            "rollup": ">=4.59.0",
            "postcss": ">=8.5.18",
            "uuid": ">=11.1.1",
            "js-yaml": ">=4.3.0",
            "adm-zip": ">=0.6.0"
        }
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,mdx,css,html,yml,yaml,graphql}": [
            "prettier --write"
        ]
    }
}
